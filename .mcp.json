{
  "mcpServers": {
    "redmine": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@leethais91/redmine-mcp-server@latest"],
      "env": {
        "REDMINE_CONFIG_PATH": "${CLAUDE_PLUGIN_DATA}/config.json"
      },
      "env_vars": ["REDMINE_URL", "REDMINE_API_KEY", "REDMINE_CONFIG_PATH"]
    }
  }
}
